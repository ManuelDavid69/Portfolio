# Copy to .env for local development. Never commit .env.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"
# Azurite (local Azure Storage emulator) well-known development connection string
STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"
CONTACT_QUEUE=contact-messages
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
PORT=3100
